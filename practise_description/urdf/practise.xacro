<?xml version="1.0"?>
<robot name="practise" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:property name="use_gazebo" value="$(arg use_gazebo)"/>

  <!-- ========== world anchor ========== -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15"/>
  </joint>

  <!-- ========== macros: inertia ========== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ========== macros: links ========== -->
  <xacro:macro name="cylinder_link" params="Link_name L R M">
    <link name="${Link_name}">
      <visual>
        <geometry>
          <cylinder length="${L}" radius="${R}"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${L}" radius="${R}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${M}" r="${R}" h="${L}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="box_link" params="Link_name X Y Z M">
    <link name="${Link_name}">
      <visual>
        <geometry>
          <box size="${X} ${Y} ${Z}"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <box size="${X} ${Y} ${Z}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${M}" x="${X}" y="${Y}" z="${Z}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="box_link_finger" params="Link_name X Y Z M x y z">
    <link name="${Link_name}">
      <visual>
        <origin xyz="${x} ${y} ${z}"/>
        <geometry>
          <box size="${X} ${Y} ${Z}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="${x} ${y} ${z}"/>
        <geometry>
          <box size="${X} ${Y} ${Z}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${M}" x="${X}" y="${Y}" z="${Z}"/>
    </link>
  </xacro:macro>

  <!-- ========== link definitions ========== -->
  <xacro:cylinder_link Link_name="base_link" L="0.3" R="0.15" M="1"/>
  <xacro:box_link Link_name="vertical_rail" X="0.1" Y="0.1" Z="0.5" M="1"/>
  <xacro:box_link Link_name="upper_arm" X="0.3" Y="0.08" Z="0.08" M="1"/>
  <xacro:box_link Link_name="lower_arm" X="0.25" Y="0.08" Z="0.08" M="1"/>
  <xacro:cylinder_link Link_name="wrist_plate" L="0.04" R="0.06" M="0.5"/>

  <xacro:box_link_finger Link_name="left_finger"
                          X="0.02" Y="0.01" Z="0.06" M="0.05"
                          x="0" y="0" z="-0.03"/>

  <xacro:box_link_finger Link_name="right_finger"
                          X="0.02" Y="0.01" Z="0.06" M="0.05"
                          x="0" y="0" z="-0.03"/>

  <!-- ========== joint definitions ========== -->

  <joint name="joint1" type="fixed">
    <parent link="base_link"/>
    <child link="vertical_rail"/>
    <origin xyz="0 0 0.4"/>
  </joint>

  <joint name="shoulder" type="prismatic">
    <parent link="vertical_rail"/>
    <child link="upper_arm"/>
    <origin xyz="0.15 0 0.25"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.2" upper="0.2" effort="10" velocity="1.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <origin xyz="0.275 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="1.0"/>
  </joint>

  <joint name="wrist" type="revolute">
    <parent link="lower_arm"/>
    <child link="wrist_plate"/>
    <origin xyz="0.125 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="1.0"/>
  </joint>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="wrist_plate"/>
    <child link="left_finger"/>
    <origin xyz="0 0.015 -0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.01" upper="0.02" effort="10" velocity="0.1"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="wrist_plate"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.015 -0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.02" upper="0.01" effort="10" velocity="0.1"/>
  </joint>

  <!-- ========== ros2_control ========== -->
  <ros2_control name="practiseSystem" type="system">
    <hardware>
      <xacro:if value="${use_gazebo}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:if>
      <xacro:unless value="${use_gazebo}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:unless>
    </hardware>

    <joint name="shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
